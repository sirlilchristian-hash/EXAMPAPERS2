# GEMINI_API_KEY: Required for Gemini AI API calls and digitization features.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Backend Admin Authentication
JWT_SECRET=super-secret-jwt-key-replace-in-production

# Supabase Integration (Optional - app gracefully uses in-memory mock store if unconfigured)
VITE_SUPABASE_URL="YOUR_SUPABASE_URL"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# M-Pesa Daraja Integration Secrets (Server-Side Only)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV=sandbox
MPESA_CALLBACK_URL=
MPESA_TRANSACTION_TYPE=
MPESA_TILL_NUMBER=
MPESA_PARTYB=

# Gmail SMTP Integration (Server-Side Only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Payment Gateway Operation Mode (simulation or daraja)
PAYMENT_MODE=simulation
ENABLE_PAYMENT_SIMULATION=false
SIMULATION_SECRET=

# GitHub Repository & Account OAuth Integration (Server-Side Only)
# Callback URL: <APP_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=

